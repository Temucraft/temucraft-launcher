# Settings for char-summary.py (copy to /etc/temucraft/char-summary.env, readable by Apache's user only:
#   chown root:www-data /etc/temucraft/char-summary.env && chmod 640 /etc/temucraft/char-summary.env). Keep it out of git
# and out of the folder Apache serves.

# A MySQL user that may only read (see README "Character summary"); a socket instead of host and port works too
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_USER=temucraft_summary
DB_PASSWORD=change-me

# The login server's database (account, realmlist)
AUTH_DB=acore_auth
# Each realm: realm id (realmlist.id) : its characters database : the world database for mail sender names, comma separated
REALMS=1:acore_characters:acore_world,3:acore_ptr_characters:acore_world

# Without a character ticket (older launchers, or a player who pressed "Not now"): which game account a launcher login
# sees. 1: the game account with the same name as the launcher login (when it isn't in ACCOUNT_MAP). 0: only the logins
# listed in ACCOUNT_MAP get anything. With ONE shared launcher login for everybody (Temucraft), use 0: otherwise a game
# account named like the shared login would be shown to everybody.
SAME_NAME=0
# "launcher login = GAMEACCOUNT, OTHERACCOUNT" lines (default: char-summary-accounts.txt next to this file)
# ACCOUNT_MAP=/etc/temucraft/char-summary-accounts.txt
# The talent map from talent-trees.py (default: talent-trees.json next to this file)
# TALENT_TREES=/etc/temucraft/talent-trees.json

# Character tickets: the launcher logs in once with the player's GAME account and password (checked against
# acore_auth.account's salt and verifier) and keeps only the ticket it gets. The ticket file (SQLite), in a folder only
# Apache's user may write: install -d -o www-data -g www-data -m 700 /var/lib/temucraft
# TICKET_DB=/var/lib/temucraft/char-tickets.sqlite
# Days until a ticket ends and the launcher asks for the password again; 0 or -1: never (it still ends when the password
# changes, at "Log out", or with --revoke). Without this line: 90.
TICKET_DAYS=0
# 1: a ticket works only from the IP it was issued to; from a new IP the launcher asks to log in again. 0: from anywhere.
TICKET_SAME_IP=1
# Failed logins allowed per IP and per account: tries/seconds (5 in 10 minutes), then "too many tries" until it passes
TICKET_LOGIN_RATE=5/600
