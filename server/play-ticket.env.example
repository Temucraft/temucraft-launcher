# Settings for play-ticket.py (copy to play-ticket.env next to it). Keep the real file out of git.
# The Apache log with the ticket requests (server/apache-play-ticket.conf.example)
TICKET_LOG=/var/log/apache2/temucraft-play-tickets.log
# The game's login port(s) that only open with a ticket: 3724 is the authserver (8085, the worldserver, can be added)
TICKET_PORTS=3724
# How long a ticket lasts, in hours (the launcher renews it every hour while the game runs)
TICKET_HOURS=12
# Addresses that never need a ticket, comma separated (your own PC for testing, ...)
TICKET_ALWAYS=
# The file the launcher asks for, inside the folder Apache serves (made by "setup")
TICKET_FILE=/var/www/wow-files/play-ticket
