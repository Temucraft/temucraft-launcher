# Copy to upload.env (git-ignored) and fill in. Used by upload.py.
SSH_HOST=vps.example.com
SSH_PORT=22
SSH_USER=deploy
# a private key (recommended) or SSH_PASSWORD
SSH_KEY=~/.ssh/id_ed25519
# set to 1 once to accept the VPS's host key the first time
TRUST_NEW_HOST=0
# the folder Apache serves for the launcher (SERVER_URL points here)
REMOTE_FILES_DIR=/var/www/wow-files
# where make-manifest.py is on the VPS
REMOTE_MANIFEST_TOOL=/var/www/make-manifest.py
REALMLIST=127.0.0.1
# where the server build goes, and commands around a server upload
REMOTE_SERVER_DIR=/opt/azerothcore
PRE_SERVER_CMD=sudo systemctl stop worldserver authserver
POST_SERVER_CMD=sudo systemctl start authserver worldserver
# upload.py dev: the _dev folder (developer tools), outside the web folder so only SSH reaches it
REMOTE_DEV_DIR=/opt/temucraft-dev
