# Copy this file next to TemucraftLauncher.exe as launcher.env and fill it in.
# launcher.env is git-ignored: the server address never goes into the repository or the exe.

# The folder Apache serves for the launcher (manifest.json is read from there), over https
SERVER_URL=https://files.example.com/wow-files/

# A self-signed certificate: its SHA-256 fingerprint, so the launcher trusts exactly that certificate
# (on the server: openssl x509 -in <cert.pem> -noout -fingerprint -sha256). Leave it out for a normal certificate.
# CERT_SHA256=AA:BB:...:FF

# Only for testing on your own network: allows http, which sends the password unencrypted
# ALLOW_HTTP=1
