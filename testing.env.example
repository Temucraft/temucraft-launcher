# Testing mode: copy this file to testing.env next to TemucraftLauncher.exe (testing.env is never in git).
# Every time you press Play, the launcher copies these files into the game folder; remove a line (or the whole
# testing.env) and the next Play takes that file out again.
#
#   <file on this computer> = <path inside the WoW folder>
#
# {locale} becomes every game language picked in the launcher (enUS, deDE ...).
# Use names the server doesn't send (patch-enUS-Z, not patch-enUS-T), or the update check will want to replace them.

F:\TemuCraft Server\_dev\login-tools\patch-enUS-Z.MPQ = Data\{locale}\patch-{locale}-Z.MPQ
