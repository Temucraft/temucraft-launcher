<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Launcher.App.MainWindow"
        Title="Temucraft Launcher" Icon="/Assets/temucraft.ico" Width="980" Height="640" MinWidth="960" MinHeight="560"
        Background="{DynamicResource T.background}" Foreground="{DynamicResource T.text}">
  <Window.Styles>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource T.text}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource T.card}" />
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="Background" Value="{DynamicResource T.card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.accent}" />
    </Style>
    <Style Selector="TextBlock.tabName">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="{DynamicResource T.titleFont}" />
    </Style>
    <Style Selector="Button.tab.selected TextBlock.tabName"><Setter Property="Foreground" Value="{DynamicResource T.accent}" /></Style>
    <Style Selector="TextBlock.tabNote">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource T.dim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- two or more views of one page (Screens: Login screen | Character screens) -->
    <Style Selector="ToggleButton.seg">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- page content stays clear of the scroll bar -->
    <Style Selector="ScrollViewer.page"><Setter Property="Padding" Value="0,0,18,0" /></Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource T.panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.border}" />
      <Setter Property="BorderThickness" Value="{DynamicResource T.borderWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource T.radius}" />
      <Setter Property="BoxShadow" Value="{DynamicResource T.frameShadow}" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource T.accent}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="{DynamicResource T.titleFont}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource T.section}" />
      <Setter Property="Background" Value="{DynamicResource T.sectionBar}" />
      <Setter Property="Padding" Value="{DynamicResource T.sectionPadding}" />
      <Setter Property="FontFamily" Value="{DynamicResource T.titleFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource T.dim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Background" Value="{DynamicResource T.play}" />
      <Setter Property="Foreground" Value="{DynamicResource T.playText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.playBorder}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{DynamicResource T.radius}" />
      <Setter Property="FontFamily" Value="{DynamicResource T.titleFont}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Width" Value="150" />
      <Setter Property="Height" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play.update">
      <Setter Property="Background" Value="{DynamicResource T.update}" />
    </Style>
    <!-- keep the theme's PLAY colours (and gradient) under the mouse; the frame lights up instead -->
    <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource T.play}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.accent}" />
      <Setter Property="Foreground" Value="{DynamicResource T.playText}" />
    </Style>
    <Style Selector="Button.play.update:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource T.update}" />
    </Style>
    <Style Selector="Button.preset">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.preset.active">
      <Setter Property="BorderBrush" Value="{DynamicResource T.accent}" />
      <Setter Property="Foreground" Value="{DynamicResource T.accent}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource T.good}" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <!-- the side menu of the settings page: plain text, brighter with a soft panel on hover -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource T.textSoft}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource T.panel}" />
      <Setter Property="Foreground" Value="{DynamicResource T.text}" />
    </Style>
    <!-- colours for text and boxes made in code (they follow the theme) -->
    <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="{DynamicResource T.accent}" /></Style>
    <Style Selector="TextBlock.text"><Setter Property="Foreground" Value="{DynamicResource T.text}" /></Style>
    <Style Selector="TextBlock.soft"><Setter Property="Foreground" Value="{DynamicResource T.textSoft}" /></Style>
    <Style Selector="TextBlock.good"><Setter Property="Foreground" Value="{DynamicResource T.good}" /></Style>
    <Style Selector="SelectableTextBlock.text"><Setter Property="Foreground" Value="{DynamicResource T.text}" /></Style>
    <Style Selector="Button.accentButton">
      <Setter Property="Background" Value="{DynamicResource T.update}" />
      <Setter Property="Foreground" Value="{DynamicResource T.playText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.tile.picked"><Setter Property="BorderBrush" Value="{DynamicResource T.accent}" /></Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource T.card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.border}" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{DynamicResource T.field}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.border}" />
    </Style>
    <!-- compact number boxes: small spinner buttons that stay inside the box -->
    <Style Selector="NumericUpDown /template/ ButtonSpinner">
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="NumericUpDown /template/ RepeatButton">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Window.Styles>

  <Panel>
    <!-- the theme's drawn texture (stone, mist...), under the player's own picture -->
    <Border Background="{DynamicResource T.texture}" IsHitTestVisible="False" />
    <Image Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.55" />
    <Border Background="{DynamicResource T.shade}" />

    <DockPanel Margin="22,14,22,14">
      <!-- header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/Assets/temucraft.png" Width="44" Height="44" Margin="0,0,10,0" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TEMUCRAFT" FontSize="30" FontWeight="Black" Foreground="{DynamicResource T.accent}" LineHeight="32"
                       FontFamily="{DynamicResource T.titleFont}" />
            <TextBlock Name="ServerText" Classes="dim" FontSize="11" Margin="2,0,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- right: the username, and the server's website links under it -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
          <TextBlock Name="AccountText" Foreground="{DynamicResource T.text}" HorizontalAlignment="Right" FontSize="13" />
          <StackPanel Name="NavLinks" Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <!-- footer -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Name="StatusText" Text="Ready." FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource T.text}" TextWrapping="Wrap" FontFeatures="tnum" />
          <TextBlock Name="VersionText" Classes="dim" FontSize="12" />
          <!-- the file being downloaded (only during an update) and, under it, the whole update -->
          <Grid Name="FileProgressRow" ColumnDefinitions="*,Auto" Margin="0,4,12,0" IsVisible="False">
            <ProgressBar Name="FileProgress" Minimum="0" Maximum="1" Height="4" Foreground="{DynamicResource T.accent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Name="FilePercentText" Classes="dim" FontSize="11" Margin="8,0,0,0" MinWidth="64" FontFeatures="tnum" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Margin="0,4,12,0">
            <ProgressBar Name="Progress" Minimum="0" Maximum="1" Height="6" Foreground="{DynamicResource T.section}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Name="TotalPercentText" Classes="dim" FontSize="11" Margin="8,0,0,0" MinWidth="64" FontFeatures="tnum" />
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="0,0,12,0">
          <Button Name="UpdateInfoButton" Classes="link" Foreground="{DynamicResource T.accent}" IsVisible="False" Click="OnUpdateInfo"
                  Content="ⓘ Update info" ToolTip.Tip="Every file the update downloads, changes or removes" />
          <Button Name="DownloadsButton" Classes="link" Foreground="{DynamicResource T.accent}" IsVisible="False" Click="OnDownloads"
                  ToolTip.Tip="Every file the updates installed: new or changed, how far along, and when it finished" />
          <Button Name="UntrackedButton" Classes="link" Foreground="{DynamicResource T.accent}" IsVisible="False" Click="OnUntracked" />
          <Button Name="CancelButton" Content="Cancel" IsVisible="False" Click="OnCancel" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <!-- Live or the PTR (test realm): each has its own install, addons and settings -->
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="Game version" Classes="dim" FontSize="12" VerticalAlignment="Center" />
            <ComboBox Name="GameVersionBox" MinWidth="150" FontSize="12"
                      ToolTip.Tip="Live: the normal realm. PTR: the test realm, with its own install (Settings page), addons and settings. PLAY goes straight into the picked realm." />
          </StackPanel>
          <TextBlock Name="GameVersionText" IsVisible="False" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource T.accent}" Margin="0,0,0,4" />
          <TextBlock Name="DebugEnabledText" Text="Debug is enabled" IsVisible="False" HorizontalAlignment="Center" FontSize="12"
                     FontWeight="SemiBold" Foreground="{DynamicResource T.accent}" Margin="0,0,0,4"
                     ToolTip.Tip="Debug mode is on (Mods page): the game logs every interface error to Logs\TemucraftDebug.log, shows error popups and opens its console with the ` key. Copy diagnostics adds the logs. Turn it off on the Mods page." />
          <Button Name="PlayButton" Classes="play" Content="PLAY" Click="OnPlay" />
          <Button Name="ReportBugButton" Classes="link" HorizontalAlignment="Right" FontSize="12" Margin="0,4,0,0" Click="OnReportBug"
                  ToolTip.Tip="Report bug: copies a short report about your game files and the last log lines to paste in your message" />
        </StackPanel>
      </Grid>

      <!-- the pages, down the left side: a name and what is on it -->
      <Border DockPanel.Dock="Left" Classes="panel" Width="206" Margin="0,0,12,0" Padding="8,10">
        <StackPanel Spacing="2">
          <Button Name="NewsTab" Classes="tab selected" Click="OnTab" Tag="0">
            <StackPanel><TextBlock Classes="tabName" Text="HOME" /><TextBlock Classes="tabNote" Text="News, changes, realms" /></StackPanel>
          </Button>
          <Button Name="ModsTab" Classes="tab" Click="OnTab" Tag="3">
            <StackPanel><TextBlock Classes="tabName" Text="MODS" /><TextBlock Classes="tabNote" Text="Models, water, DXVK and more" /></StackPanel>
          </Button>
          <Button Name="AddonsTab" Classes="tab" Click="OnTab" Tag="2">
            <StackPanel><TextBlock Classes="tabName" Text="ADDONS" /><TextBlock Classes="tabNote" Text="Interface addons" /></StackPanel>
          </Button>
          <Button Name="ScreensTab" Classes="tab" Click="OnTab" Tag="6">
            <StackPanel><TextBlock Classes="tabName" Text="SCREENS" /><TextBlock Classes="tabNote" Text="Login and character screens" /></StackPanel>
          </Button>
          <Button Name="TweaksTab" Classes="tab" Click="OnTab" Tag="1">
            <StackPanel><TextBlock Classes="tabName" Text="GAME SETTINGS" /><TextBlock Classes="tabNote" Text="Graphics, sound, interface" /></StackPanel>
          </Button>
          <Border Height="1" Background="{DynamicResource T.border}" Margin="6,8" />
          <Button Name="SettingsTab" Classes="tab" Click="OnTab" Tag="4">
            <StackPanel><TextBlock Classes="tabName" Text="GAME FILES" /><TextBlock Classes="tabNote" Text="Folder, languages, updates" /></StackPanel>
          </Button>
          <Button Name="LauncherTab" Classes="tab" Click="OnTab" Tag="5">
            <StackPanel><TextBlock Classes="tabName" Text="LAUNCHER" /><TextBlock Classes="tabNote" Text="Account, look, privacy, log" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Top" Name="WarningBanner" IsVisible="False" Background="{DynamicResource T.warning}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Name="WarningText" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Name="LauncherUpdateButtons" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" IsVisible="False">
              <Button Name="WhatsNewButton" Content="What changed" Click="OnWhatsNew" />
              <Button Name="UpdateLauncherButton" Classes="accentButton" Content="Update the launcher" Click="OnUpdateLauncher" />
              <Button Content="Later" Click="OnLauncherLater" />
            </StackPanel>
          </Grid>
          <Border Name="WhatsNewPanel" IsVisible="False" Classes="card" BorderThickness="1" CornerRadius="4" Padding="10,8" MaxHeight="260">
            <ScrollViewer Classes="page"><StackPanel Name="WhatsNewList" /></ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <!-- realm status from the website (?realm-status=data), shown with the news page -->
      <Border DockPanel.Dock="Top" Name="RealmPanel" Classes="card" IsVisible="False" BorderThickness="1" CornerRadius="4" Padding="12,6" Margin="0,0,0,8">
        <Grid ColumnDefinitions="*,Auto">
          <WrapPanel Name="RealmList" Orientation="Horizontal" VerticalAlignment="Center" />
          <Button Grid.Column="1" Name="PlayerMapButton" Classes="link" Content="Player map" Click="OnPlayerMap" VerticalAlignment="Center"
                  IsVisible="False" ToolTip.Tip="Who is online and where, on the website" />
        </Grid>
      </Border>

      <Panel>
        <!-- 0 news -->
        <Grid Name="NewsPage" ColumnDefinitions="*,12,*">
          <Border Name="NewsPanel" Classes="panel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="title" Text="NEWS" />
              <ScrollViewer Classes="page"><StackPanel Name="NewsList" Spacing="14" /></ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Name="ChangelogPanel" Classes="panel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="title" Text="CHANGELOG" Margin="0,0,0,2" />
              <TextBlock DockPanel.Dock="Top" Name="TagLegend" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />
              <ScrollViewer Classes="page"><StackPanel Name="ChangelogList" Spacing="14" /></ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>

        <!-- 1 tweaks -->
        <Border Name="TweaksPage" Classes="panel" IsVisible="False">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <TextBlock Classes="title" Text="GAME SETTINGS" Margin="0,0,0,2" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Wow.exe, DXVK and Awesome WotLK (while they are on), then every option of the game's Interface, Video and Sound windows (WTF\Config.wtf)." />
              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBox Name="TweaksSearch" Watermark="Search all settings (Ctrl+F)" MaxWidth="520" HorizontalAlignment="Left" Width="520" />
                <TextBlock Grid.Column="1" Name="TweaksSearchCount" Classes="dim" VerticalAlignment="Center" Margin="10,0,0,0" />
              </Grid>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
              <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="PresetServer" Classes="preset" Content="Server recommended" Click="OnServerTweaks" />
                <Button Name="PresetRecommended" Classes="preset" Content="Recommended" Click="OnRecommendedTweaks" />
                <Button Name="PresetDefault" Classes="preset" Content="Restore defaults" Click="OnDefaultTweaks"
                        ToolTip.Tip="Back to the launcher's defaults" />
                <TextBlock Name="PresetCustom" Text="Custom" Foreground="{DynamicResource T.accent}" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="False"
                           ToolTip.Tip="Your own values: none of the presets" />
                <Border Width="1" Background="{DynamicResource T.border}" Margin="4,2" />
                <Button Name="CopySettingsButton" Content="Copy settings" Click="OnCopySettings"
                        ToolTip.Tip="Your tweaks and launcher settings as text, to paste on another PC or send to a friend" />
                <Button Content="Import settings" Click="OnImportSettings"
                        ToolTip.Tip="Fill in settings copied with Copy settings (from the clipboard)" />
                <Button Content="Change config preset" Click="OnChangeConfigPreset"
                        ToolTip.Tip="Performance or Fidelity: many graphics settings at once, and the mods that go with them" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                <Button Name="DiscardTweaksButton" Content="✕ Discard" Click="OnDiscardTweaks" IsVisible="False" Foreground="#E57373"
                        ToolTip.Tip="Go back to the values in your game's Config.wtf" />
                <Button Name="ApplyTweaksButton" Content="✓ Apply" Click="OnSaveTweaks" IsVisible="False" Foreground="{DynamicResource T.good}" FontWeight="SemiBold"
                        ToolTip.Tip="Write the changes to WTF\Config.wtf (close the game first)" />
              </StackPanel>
              </Grid>
              <TextBlock Name="PresetChanges" Classes="dim" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock Classes="dim" TextWrapping="Wrap">
                <Run Text="Highlighted" Foreground="{DynamicResource T.good}" FontWeight="SemiBold" />
                <Run Text=" options are the launcher's recommended ones. Changes are written to WTF\Config.wtf when you press Apply; close the game first." />
              </TextBlock>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Name="TweaksHint" Classes="dim" IsVisible="False" Margin="0,0,0,8"
                       Text="These are read from your game's WTF\Config.wtf: pick your WoW folder under Game files, or install the game files there first." />
            <Grid ColumnDefinitions="190,*">
              <ScrollViewer Classes="page" Padding="0,0,8,0"><StackPanel Name="TweaksMenu" Spacing="0" Margin="0,4,8,0" /></ScrollViewer>
              <Border Grid.Column="1" BorderBrush="{DynamicResource T.border}" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                <ScrollViewer Classes="page"><StackPanel Name="TweaksList" /></ScrollViewer>
              </Border>
            </Grid>
          </DockPanel>
        </Border>

        <!-- 6 screens -->
        <Border Name="ScreensPage" Classes="panel" IsVisible="False">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Classes="title" Text="SCREENS" Margin="0,0,0,2" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="What you see before you enter the world: the login screen and the scene behind each race on character select and create." />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                <ToggleButton Name="ScreensLoginTab" Classes="seg" Content="Login screen" Click="OnScreensTab" />
                <ToggleButton Name="ScreensCharTab" Classes="seg" Content="Character screens" Click="OnScreensTab" />
              </StackPanel>
            </StackPanel>
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="ScreensDirtyText" Classes="accent" FontWeight="SemiBold" IsVisible="False" Text="Changes not saved" />
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Save writes your picks into the game folder; they show the next time the game starts." />
              </StackPanel>
              <Button Grid.Column="1" Classes="accentButton" Content="Save" Padding="22,6" Click="OnSaveScreens" />
            </Grid>
            <ScrollViewer Classes="page">
              <StackPanel>
                <StackPanel Name="ScreensLoginList" />
                <StackPanel Name="ScreensCharList" IsVisible="False" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- 2 addons -->
        <Grid Name="AddonsPage" ColumnDefinitions="3*,12,2*" IsVisible="False">
          <Border Classes="panel">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Content="Check for updates" Click="OnCheckAddonUpdates" />
                <Button Content="Update all" Click="OnUpdateAllAddons" />
                <Button Name="InstallRecommendedButton" Content="Install recommended" Click="OnInstallRecommended" />
                <Button Content="Open AddOns folder" Click="OnOpenAddons" />
                <Button Name="CopyAddonsFromLiveButton" Content="Copy my addons from Live" Click="OnCopyAddonsFromLive" IsVisible="False"
                        ToolTip.Tip="Copies every addon in your Live Interface\AddOns, with its settings, to the PTR (once; the PTR's old ones are backed up)" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,18,8">
                <TextBlock Classes="title" Name="CatalogTitle" Text="FROM THE SERVER" />
                <TextBox Name="CatalogSearch" Watermark="Search addons (name, what it does, category)" />
                <WrapPanel Name="CatalogCategories" />
              </StackPanel>
              <ScrollViewer Classes="page">
                <StackPanel>
                  <StackPanel Name="CatalogList" Spacing="4" />
                  <TextBlock Classes="title" Text="INSTALLED" Margin="0,16,0,10" />
                  <StackPanel Name="InstalledList" Spacing="4" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Classes="panel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Name="PreviewTitle" Classes="title" Text="PREVIEW" />
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Name="PreviewInstall" Content="Install" IsVisible="False" Click="OnPreviewInstall" />
                <Button Name="PreviewOpen" Classes="link" Content="Open on GitHub" IsVisible="False" Click="OnPreviewOpen" />
              </StackPanel>
              <ScrollViewer Classes="page">
                <SelectableTextBlock Name="PreviewText" TextWrapping="Wrap" Foreground="{DynamicResource T.textSoft}"
                                     Text="Pick an addon from the server's list to see its page." />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>

        <!-- 3 mods -->
        <Border Name="ModsPage" Classes="panel" IsVisible="False">
          <ScrollViewer Classes="page">
            <StackPanel>
              <TextBlock Classes="title" Text="MODS" />
              <TextBlock Classes="dim" Text="Fixes and extras from the server, never gameplay. The fixes are on by default; turn off any you don't want. Changes are installed (or removed) at the next update." />
              <WrapPanel Name="OptionsList" Margin="0,10,0,0" />
              <TextBlock Classes="section" Text="UNTRACKED PATCHES" />
              <TextBlock Classes="dim" Text="Patches in Data that neither the client nor the server hand out. They can break the game; removing moves them to the launcher's backup folder." />
              <StackPanel Name="UntrackedList" Margin="0,6,0,0" Spacing="4" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- 4 settings -->
        <Border Name="SettingsPage" Classes="panel" IsVisible="False">
          <ScrollViewer Classes="page">
            <StackPanel>
              <TextBlock Classes="title" Text="GAME FILES" Margin="0,0,0,2" />
              <TextBlock Classes="dim" Text="Where the game is, which languages to install, downloads, updates and backups." />

              <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,10,0,12">
              <StackPanel>
              <TextBlock Classes="section" Margin="0,0,0,6" Text="WORLD OF WARCRAFT 3.3.5a FOLDER" />
              <Grid ColumnDefinitions="*,8,Auto,8,Auto,8,Auto">
                <TextBox Name="WowFolderBox" Watermark="C:\Games\World of Warcraft" />
                <Button Grid.Column="2" Content="Browse…" Click="OnBrowseWow" />
                <Button Grid.Column="4" Content="Open folder" Click="OnOpenGameFolder" ToolTip.Tip="Open the game folder in your file manager" />
                <Button Grid.Column="6" Name="ClientButton" Content="Install game files…" Click="OnDownloadClient" />
              </Grid>
              <TextBlock Classes="dim" Margin="0,4,0,0" Text="No game yet? Press Install game files… and pick an empty folder: the whole client is downloaded there." />
              </StackPanel>
              </Border>

              <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
              <StackPanel>
              <TextBlock Classes="section" Margin="0,0,0,6" Text="PTR (TEST REALM) FOLDER" />
              <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                <TextBox Name="PtrFolderBox" />
                <Button Grid.Column="2" Content="Browse…" Click="OnBrowsePtr" />
                <Button Grid.Column="4" Content="Open folder" Click="OnOpenPtrFolder" ToolTip.Tip="Open the PTR's folder in your file manager" />
              </Grid>
              <TextBlock Name="PtrStateText" Classes="dim" Margin="0,4,0,0" TextWrapping="Wrap" />
              <TextBlock Classes="dim" Margin="0,2,0,0" TextWrapping="Wrap" Text="The PTR has its own settings, key bindings and addons. Copy yours from Live when you want them there (the PTR's old files are backed up; Live is never changed):" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button Name="CopyAccountDataButton" Content="Copy Account Data" Click="OnCopyAccountData"
                        ToolTip.Tip="Live's game settings, macros and addon settings (per account and per character) to the PTR" />
                <Button Name="CopyKeyBindingsButton" Content="Copy Key Bindings" Click="OnCopyKeyBindings"
                        ToolTip.Tip="Live's key bindings (per account and per character) to the PTR" />
              </StackPanel>
              </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,32,*">
                <StackPanel>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="LANGUAGES" />
                  <TextBlock Classes="dim" Text="The game languages to install." />
                  <WrapPanel Name="LocalePanel" Margin="0,4,0,0" />
                  </StackPanel>
                  </Border>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="GAME" />
                  <CheckBox Name="AddonsBox" Content="Install the addons the server needs" IsChecked="True" />
                  <CheckBox Name="ClearCacheBox" Content="Clean the client's Cache (WDB) on each launch" IsChecked="True" />
                  </StackPanel>
                  </Border>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="SHARED SETTINGS" />
                  <CheckBox Name="ShareBox"><TextBlock TextWrapping="Wrap" Text="Keep my settings (like auto loot), key bindings and macros the same on all my accounts on this PC" /></CheckBox>
                  <CheckBox Name="ShareAddonsBox" Margin="24,0,0,0" Content="Also addon settings" />
                  <CheckBox Name="ShareCharsBox" Margin="24,0,0,0"><TextBlock TextWrapping="Wrap" Text="Also between my characters (their own key bindings and macros)" /></CheckBox>
                  <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                             Text="The newest copy wins, before the game starts and after it closes; a backup is made first. The server can do the same between PCs." />
                  <Button Content="Share now" Click="OnShareNow" Margin="0,6,0,0" />
                  </StackPanel>
                  </Border>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="BACKUPS" />
                  <TextBlock Classes="dim" Text="Your settings, macros, key bindings and addons (WTF and Interface\AddOns)." />
                  <CheckBox Name="BackupBox" Content="Back up before every update" IsChecked="True" />
                  <ComboBox Name="BackupList" HorizontalAlignment="Stretch" Margin="0,6,0,0" ToolTip.Tip="Date format: DD-MM-YYYY HH:MM:SS" />
                  <TextBlock Name="BackupTotal" Classes="dim" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="Back up now" Click="OnBackupNow" Margin="0,0,8,6" />
                    <Button Content="Restore" Click="OnRestoreBackup" Margin="0,0,8,6" />
                    <Button Content="Delete" Click="OnDeleteBackup" Margin="0,0,8,6" ToolTip.Tip="Delete the backup picked above" />
                    <Button Content="Delete all" Click="OnDeleteAllBackups" Margin="0,0,8,6" ToolTip.Tip="Delete every backup and the moved patches" />
                    <Button Content="Open folder" Click="OnOpenBackups" Margin="0,0,8,6" />
                  </WrapPanel>
                  <WrapPanel>
                    <Button Content="Export macros and key bindings…" Click="OnExportMacros" Margin="0,0,8,6" />
                    <Button Content="Import macros and key bindings…" Click="OnImportMacros" Margin="0,0,8,6" />
                  </WrapPanel>

                
                  </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="CHECK THE GAME FILES" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Verify game files" Click="OnVerify" />
                    <Button Name="UpdateButton" Content="Check for updates" Click="OnUpdate" />
                  </StackPanel>
                  </StackPanel>
                  </Border>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="DOWNLOADS" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox Name="LimitBox" Content="Limit download speed" />
                    <NumericUpDown Name="LimitNumber" Width="150" Height="32" MinHeight="32" Minimum="1" Maximum="10000000" Increment="100"
                                   FormatString="0" ClipValueToMinMax="True" VerticalContentAlignment="Center" />
                    <TextBlock Name="LimitUnit" Text="KB/s" VerticalAlignment="Center" />
                      <TextBlock Name="LimitEquivalent" Classes="dim" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Name="ServerCapNote" Classes="dim" FontSize="12" IsVisible="False" />
                  <CheckBox Name="BitsBox" Content="Show download speeds in bits per second" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button Name="SpeedTestButton" Content="Test my speed" Click="OnSpeedTest"
                            ToolTip.Tip="Downloads a little from the server for a few seconds to measure your speed" />
                    <TextBlock Name="SpeedTestText" Classes="dim" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                    <Button Name="UseSuggestedButton" Content="Use the suggested limit" Click="OnUseSuggestedLimit" IsVisible="False" />
                  </StackPanel>
                  <Button Content="Clear download cache" Click="OnClearDownloadCache" Margin="0,8,0,0" />
                  <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                             Text="Forgets which files were already checked and removes unfinished downloads. Can fix updates that keep failing." />
                  <Button Name="ClearKeptButton" Content="Remove kept option files" Click="OnClearKept" Margin="0,8,0,0" ToolTip.Tip="Files of mods you turned off are kept so switching back needs no download. This frees that space." />
                  </StackPanel>
                  </Border>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="UPDATES" />
                  <CheckBox Name="AutoUpdateBox"><TextBlock TextWrapping="Wrap" Text="Update by itself (when the launcher opens, and every 30 minutes while it is open)" /></CheckBox>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox Name="HoursBox" Content="Only between" />
                    <ComboBox Name="FromBox" Width="90" />
                    <TextBlock Text="and" VerticalAlignment="Center" />
                    <ComboBox Name="ToBox" Width="90" />
                    <TextBlock Name="HoursNote" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="dim" FontSize="12" Text="Automatic updates wait while the game is running." />
                
                  </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- 5 launcher -->
        <Border Name="LauncherPage" Classes="panel" IsVisible="False">
          <ScrollViewer Classes="page">
            <StackPanel>
              <TextBlock Classes="title" Text="LAUNCHER" Margin="0,0,0,2" />
              <TextBlock Classes="dim" Text="The launcher itself: your login, language, look, window and privacy." />
              <Grid ColumnDefinitions="*,32,*">
                <StackPanel>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <StackPanel Name="AccountSection">
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="ACCOUNT (the login for the server's game files)" />
                  <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                    <TextBox Name="UsernameBox" Watermark="Username" />
                    <TextBox Grid.Column="2" Name="PasswordBox" Watermark="Password" PasswordChar="•" />
                    <CheckBox Grid.Row="1" Name="RememberBox" Content="Remember password (Windows Credential Manager)" />
                    <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Content="Connect" Click="OnConnect" Margin="0,4,0,0" />
                  </Grid>
                  <TextBlock Classes="dim" Margin="0,4,0,0" Text="Your own login from the server's owner." />
                  </StackPanel>
                  </StackPanel>
                  </Border>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="LOOK" />
                  <CheckBox Name="ReopenBox" Content="Bring the launcher back when WoW closes" IsChecked="True" />
                  <CheckBox Name="RememberWindowBox" Content="Remember position and size of the launcher window" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <TextBlock VerticalAlignment="Center" Text="Launcher background:" />
                    <Button Content="Choose picture…" Click="OnPickBackground" />
                    <Button Content="Default" Click="OnDefaultBackground" />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
                    <TextBlock Text="Language:" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" Name="LanguageBox" HorizontalAlignment="Stretch" SelectionChanged="OnLanguagePicked" />
                    <TextBlock Grid.Row="1" Text="Theme:" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="2" Name="ThemeBox" HorizontalAlignment="Stretch" Margin="0,6,0,0" SelectionChanged="OnThemePicked" />
                    <TextBlock Grid.Row="2" Text="Mode:" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="2" Grid.Column="2" Name="ModeBox" HorizontalAlignment="Stretch" Margin="0,6,0,0" SelectionChanged="OnThemePicked" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Name="CopySettingsButton2" Content="Copy settings" Click="OnCopySettings"
                            ToolTip.Tip="Your tweaks and launcher settings as text, to paste on another PC or send to a friend" />
                    <Button Content="Import settings" Click="OnImportSettings"
                            ToolTip.Tip="Fill in settings copied with Copy settings (from the clipboard)" />
                  </StackPanel>
                  </StackPanel>
                  </Border>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="WINDOW" />
                  <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="When the game starts:" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" Name="GameLaunchBox" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Row="1" Text="When closing the window (X):" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="2" Name="CloseBox" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Text="At start, show:" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="2" Grid.Column="2" Name="StartPageBox" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                  </Grid>
                  <Button Content="Create a desktop shortcut" Click="OnDesktopShortcut" Margin="0,8,0,0"
                          ToolTip.Tip="A shortcut to this launcher on your desktop" />

                  <TextBlock Name="LanguageNote" Classes="dim" FontSize="12" Margin="0,4,0,0" IsVisible="False"
                             Text="The new language shows fully after restarting the launcher." />
                  <TextBlock Name="LauncherVersionText" Classes="dim" Margin="0,10,0,0" />

                
                  </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="WHAT THIS SERVER COLLECTS (THE LOGIN NOTICE)" />
                  <SelectableTextBlock Name="PrivacyText" TextWrapping="Wrap" Foreground="{DynamicResource T.textSoft}" FontSize="12" />
                  <StackPanel Name="PrivacyValuesTitle" Orientation="Horizontal" Spacing="10" Margin="0,10,0,4">
                    <TextBlock Text="What this PC sends:" Foreground="{DynamicResource T.textSoft}" FontSize="12" VerticalAlignment="Center" />
                    <Button Name="CopyValuesButton" Content="Copy to clipboard" FontSize="12" Padding="8,2" Click="OnCopyValues" />
                  </StackPanel>
                  <Grid Name="PrivacyValuesBox" ColumnDefinitions="Auto,12,*" />
                  <TextBlock Text="Date format: &quot;DD-MM-YYYY HH:MM:SS&quot;" Foreground="{DynamicResource T.dimmer}" FontSize="11" Margin="0,8,0,0" />
                  <TextBlock Name="PrivacyAgreed" Foreground="{DynamicResource T.textSoft}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  </Border>
                  <Border Classes="card" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                  <TextBlock Classes="section" Margin="0,0,0,6" Text="LOG" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Open log file" Click="OnOpenLog" />
                    <Button Content="Open file location" Click="OnOpenLogFolder" ToolTip.Tip="Show the log file in its folder" />
                    <Button Name="DiagnosticsButton" Content="Copy diagnostics" Click="OnCopyDiagnostics"
                            ToolTip.Tip="Copies a short report about your game files. Send it to the server's admin when the game won't start." />
                  </StackPanel>
                  <TextBox Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="220" Margin="0,8,0,0"
                           FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12" MinHeight="220" />
                
                  </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Panel>
    </DockPanel>

    <!-- recent downloads: each file an update installs -->
    <Border Name="DownloadsPanel" IsVisible="False" Width="400" MaxHeight="520" CornerRadius="6" Background="{DynamicResource T.background}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,96" BoxShadow="0 4 18 0 #80000000">
     <Border Classes="panel" CornerRadius="6" Padding="16,12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
          <TextBlock Text="Recent downloads" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource T.accent}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Content="Clear" Click="OnClearDownloads" Margin="0,0,8,0"
                  ToolTip.Tip="Remove the finished files from this list" />
          <Button Grid.Column="2" Content="X" Click="OnCloseDownloads" Padding="8,2" />
        </Grid>
        <TextBlock Name="DownloadsEmpty" DockPanel.Dock="Top" Classes="dim" Text="Nothing downloaded yet." IsVisible="False" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
          <StackPanel Name="DownloadsList" />
        </ScrollViewer>
      </DockPanel>
     </Border>
    </Border>

    <!-- update info: every change an update makes, before it starts -->
    <Grid Name="UpdateInfoOverlay" Background="{DynamicResource T.overlay}" IsVisible="False">
      <Border Background="{DynamicResource T.background}" Width="720" MaxHeight="640" Margin="20" CornerRadius="6"
              HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Classes="panel" CornerRadius="6" Padding="24,18">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <TextBlock Classes="title" Text="UPDATE INFO" FontSize="24" />
            <Button Grid.Column="1" Content="X" Click="OnUpdateInfoClose" Padding="8,2" VerticalAlignment="Top" />
          </Grid>
          <StackPanel DockPanel.Dock="Top" Spacing="2">
            <TextBlock Text="INSTALL LOCATION:" FontWeight="SemiBold" Foreground="{DynamicResource T.text}" />
            <TextBlock Name="UpdateInfoFolder" Foreground="{DynamicResource T.accent}" TextWrapping="Wrap" />
            <TextBlock Classes="dim" FontSize="12" Text="The WoW folder picked under Game files." />
            <TextBlock Name="UpdateInfoSummary" FontWeight="SemiBold" Foreground="{DynamicResource T.text}" Margin="0,12,0,0" />
            <TextBlock Classes="dim" Text="These changes are in the update:" Margin="0,0,0,6" />
          </StackPanel>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <CheckBox Name="UpdateInfoSkip" Content="Don't ask again (Update info stays one click away)" />
            <Button Grid.Column="1" Name="UpdateInfoContinue" Classes="play" Content="Continue" Click="OnUpdateInfoContinue"
                    FontSize="16" Padding="22,8" />
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel Name="UpdateInfoList" />
          </ScrollViewer>
        </DockPanel>
       </Border>
      </Border>
    </Grid>

    <!-- what's new: once after the launcher updated -->
    <Grid Name="StartupNewsOverlay" Background="{DynamicResource T.overlay}" IsVisible="False">
      <Border Background="{DynamicResource T.background}" Width="760" MaxHeight="660" Margin="20" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Classes="panel" CornerRadius="6" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource T.border}" BorderThickness="0,0,0,1" Padding="24,18">
            <TextBlock Classes="title" Text="WHAT'S NEW" FontSize="28" Margin="0" />
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource T.border}" BorderThickness="0,1,0,0" Padding="24,12">
            <Button Classes="link" Content="→  Continue" FontSize="16" HorizontalAlignment="Right" Click="OnWhatsNewContinue" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14,24,14">
            <StackPanel>
              <TextBlock Name="StartupNewsVersion" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource T.text}" Margin="0,0,0,6" />
              <StackPanel Name="StartupNewsList" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
       </Border>
      </Border>
    </Grid>

    <!-- first start: a configuration preset -->
    <Grid Name="ConfigPresetOverlay" Background="{DynamicResource T.overlay}" IsVisible="False">
      <Border Background="{DynamicResource T.background}" Width="760" Margin="20" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Classes="panel" CornerRadius="6" Padding="0">
        <StackPanel>
          <Border BorderBrush="{DynamicResource T.border}" BorderThickness="0,0,0,1" Padding="24,18">
            <TextBlock Classes="title" Text="SELECT CONFIGURATION PRESET" FontSize="28" Margin="0" />
          </Border>
          <StackPanel Margin="24,16,24,20" Spacing="14">
            <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource T.text}"
                       Text="Choose a preset to apply to your game's settings. It also turns on the mods that go with it." />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,14,Auto,14,Auto">
              <Button Classes="link" Content="✕  Skip preset" FontSize="16" Foreground="{DynamicResource T.text}" Click="OnConfigPresetSkip" />
              <TextBlock Grid.Column="1" Classes="dim" FontSize="14" VerticalAlignment="Center"
                         Text="Keep all your current settings and mods." />
              <Button Grid.Row="2" Classes="link" Content="▷▷  Performance" FontSize="16" Foreground="#C8D45A" Tag="performance" Click="OnConfigPresetPick" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="dim" FontSize="14" MaxWidth="480" VerticalAlignment="Center"
                           Text="Fewer effects, more frames. Best for raids, or when the game stutters or freezes." />
                <Button Classes="link" Content="ⓘ" FontSize="16" Tag="performance" Click="OnConfigPresetInfo" ToolTip.Tip="Included settings" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Row="4" Classes="link" Content="✦  Fidelity" FontSize="16" Foreground="#F07050" Tag="fidelity" Click="OnConfigPresetPick" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="dim" FontSize="14" VerticalAlignment="Center" Text="The best looks and the most detail." />
                <Button Classes="link" Content="ⓘ" FontSize="16" Tag="fidelity" Click="OnConfigPresetInfo" ToolTip.Tip="Included settings" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
       </Border>
      </Border>
    </Grid>

    <!-- what a preset sets -->
    <Grid Name="IncludedOverlay" Background="{DynamicResource T.overlay}" IsVisible="False">
      <Border Background="{DynamicResource T.background}" Width="680" MaxHeight="560" Margin="20" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Classes="panel" CornerRadius="6" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <Border BorderBrush="{DynamicResource T.border}" BorderThickness="0,0,0,1" Padding="24,18" Grid.ColumnSpan="2">
              <TextBlock Classes="title" Text="INCLUDED SETTINGS" FontSize="26" Margin="0" />
            </Border>
            <Button Grid.Column="1" Content="X" Click="OnIncludedClose" Padding="8,2" Margin="0,14,16,0" VerticalAlignment="Top" />
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12,24,16">
            <StackPanel Spacing="4">
              <TextBlock Name="IncludedTitle" Classes="section" Margin="0,0,0,4" />
              <TextBlock Text="MODS:" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource T.text}" />
              <TextBlock Name="IncludedMods" Margin="8,0,0,6" Foreground="{DynamicResource T.text}" />
              <TextBlock Text="CONFIG.WTF SETTINGS:" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource T.text}" />
              <SelectableTextBlock Name="IncludedSettings" Margin="8,0,0,0" FontFamily="Consolas, Cascadia Mono, monospace" Foreground="{DynamicResource T.text}" LineHeight="24" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
       </Border>
      </Border>
    </Grid>

    <!-- installing the game: where, what, and how big each part and the whole is -->
    <Grid Name="InstallOverlay" Background="{DynamicResource T.overlay}" IsVisible="False">
      <Border Classes="panel" Width="720" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" CornerRadius="6">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Classes="title" Text="INSTALL THE GAME" Margin="0" />
            <TextBlock Classes="dim" FontSize="12" Text="Already have WoW 3.3.5a? Cancel and pick its folder under Game files instead." />
            <TextBlock Text="Install into:" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox Name="InstallFolderBox" />
              <Button Grid.Column="2" Content="Browse…" Click="OnInstallBrowse" />
            </Grid>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <Border Height="1" Background="{DynamicResource T.border}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Total" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Grid.Column="1" Name="InstallTotal" FontWeight="SemiBold" FontSize="15" />
            </Grid>
            <TextBlock Name="InstallFree" Classes="dim" FontSize="12" HorizontalAlignment="Right" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" Click="OnInstallCancel" />
              <Button Name="InstallGoButton" Classes="accentButton" Content="Install" Click="OnInstallGo" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer MaxHeight="380" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="InstallParts" Spacing="3" Margin="0,0,26,0" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- login: asked first, like a website's login prompt; form on the left, what's sent on the right (no scrolling) -->
    <Grid Name="LoginOverlay" Background="{DynamicResource T.overlay}" IsVisible="False">
      <Border Classes="panel" MaxWidth="900" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="26,22">
        <ScrollViewer Name="LoginScroll" VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="320,26,*">
            <StackPanel Spacing="10" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Image Source="/Assets/temucraft.png" Width="56" Height="56" />
                <TextBlock Text="TEMUCRAFT" FontSize="30" FontWeight="Black" Foreground="{DynamicResource T.accent}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="dim" HorizontalAlignment="Center" TextAlignment="Center"
                         Text="Log in to get the game files. Your login comes from the server's owner." />
              <TextBox Name="LoginUser" Watermark="Username" />
              <TextBox Name="LoginPass" Watermark="Password" PasswordChar="•" />
              <CheckBox Name="LoginRemember" Content="Remember me" />
              <TextBlock Name="LoginError" Foreground="{DynamicResource T.bad}" TextWrapping="Wrap" IsVisible="False" />
              <Grid ColumnDefinitions="*,8,Auto">
                <Button Name="LoginButton" Content="Log in" IsDefault="True" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Click="OnLogin" />
                <Button Grid.Column="2" Content="Not now" Click="OnLoginLater" />
              </Grid>
              <WrapPanel Name="LoginLinks" HorizontalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource T.cardStrong}" CornerRadius="4" Padding="14,12" VerticalAlignment="Center">
              <StackPanel Spacing="6">
                <TextBlock Text="WHAT THE LAUNCHER SENDS" Foreground="{DynamicResource T.section}" FontWeight="SemiBold" FontSize="13" />
                <SelectableTextBlock Name="CollectNotice" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource T.textSoft}" LineHeight="17" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    <!-- error popups -->
    <StackPanel Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="6" Width="340" />
  </Panel>
</Window>
