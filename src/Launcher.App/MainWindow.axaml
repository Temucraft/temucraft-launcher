<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Launcher.App.MainWindow"
        Title="Temucraft Launcher" Icon="/Assets/temucraft.ico" Width="980" Height="640" MinWidth="820" MinHeight="560"
        Background="#0E0B14">
  <Window.Styles>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E8E2D0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="Foreground" Value="#F2C14E" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#CC120E1A" />
      <Setter Property="BorderBrush" Value="#3A3346" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="Foreground" Value="#F2C14E" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="#E0894A" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#9A93A8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Background" Value="#3E7A1E" />
      <Setter Property="Foreground" Value="#E8F5C8" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Width" Value="150" />
      <Setter Property="Height" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play.update">
      <Setter Property="Background" Value="#B5501E" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8FC24A" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
  </Window.Styles>

  <Panel>
    <Image Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.55" />
    <Border Background="#66000000" />

    <DockPanel Margin="22,14,22,14">
      <!-- header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/Assets/temucraft.png" Width="44" Height="44" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Text="TEMUCRAFT" FontSize="30" FontWeight="Black" Foreground="#F2C14E" VerticalAlignment="Center" />
          <TextBlock Name="ServerText" Classes="dim" VerticalAlignment="Center" Margin="12,6,0,0" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center" Spacing="2">
          <Button Name="NewsTab" Classes="tab selected" Content="NEWS" Click="OnTab" Tag="0" />
          <Button Name="TweaksTab" Classes="tab" Content="TWEAKS" Click="OnTab" Tag="1" />
          <Button Name="AddonsTab" Classes="tab" Content="ADDONS" Click="OnTab" Tag="2" />
          <Button Name="ModsTab" Classes="tab" Content="OPTIONS" Click="OnTab" Tag="3" />
          <Button Name="SettingsTab" Classes="tab" Content="SETTINGS" Click="OnTab" Tag="4" />
          <Button Name="LauncherTab" Classes="tab" Content="LAUNCHER" Click="OnTab" Tag="5" />
        </StackPanel>
        <TextBlock Grid.Column="2" Name="AccountText" Foreground="#E8E2D0" VerticalAlignment="Center" />
      </Grid>

      <!-- footer -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Name="StatusText" Text="Ready." FontSize="15" FontWeight="SemiBold" Foreground="#E8E2D0" TextWrapping="Wrap" />
          <TextBlock Name="VersionText" Classes="dim" FontSize="12" />
          <ProgressBar Name="Progress" Minimum="0" Maximum="1" Height="6" Foreground="#E0894A" Margin="0,4,12,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="0,0,12,0">
          <Button Name="UntrackedButton" Classes="link" Foreground="#F2C14E" IsVisible="False" Click="OnUntracked" />
          <Button Name="CancelButton" Content="Cancel" IsVisible="False" Click="OnCancel" />
        </StackPanel>
        <Button Grid.Column="2" Name="PlayButton" Classes="play" Content="PLAY" Click="OnPlay" />
      </Grid>

      <Border DockPanel.Dock="Top" Name="WarningBanner" IsVisible="False" Background="#5A3A00" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
        <TextBlock Name="WarningText" TextWrapping="Wrap" />
      </Border>

      <Panel>
        <!-- 0 news -->
        <Grid Name="NewsPage" ColumnDefinitions="*,12,*">
          <Border Classes="panel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="title" Text="NEWS" />
              <ScrollViewer><StackPanel Name="NewsList" Spacing="14" /></ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Classes="panel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="title" Text="CHANGELOG" />
              <ScrollViewer><StackPanel Name="ChangelogList" Spacing="14" /></ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>

        <!-- 1 tweaks -->
        <Border Name="TweaksPage" Classes="panel" IsVisible="False">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
              <Button Content="Save" Click="OnSaveTweaks" />
              <Button Content="Use recommended" Click="OnRecommendedTweaks" />
              <Button Content="Restore defaults" Click="OnDefaultTweaks" />
              <TextBlock Classes="dim" VerticalAlignment="Center" Text="Highlighted options are recommended. Changes are written to WTF\Config.wtf; close the game first." />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Name="TweaksHint" Classes="dim" IsVisible="False" Margin="0,0,0,8"
                       Text="These are read from your game's WTF\Config.wtf: pick your WoW folder under Settings, or install the game files there first." />
            <ScrollViewer><StackPanel Name="TweaksList" /></ScrollViewer>
          </DockPanel>
        </Border>

        <!-- 2 addons -->
        <Grid Name="AddonsPage" ColumnDefinitions="3*,12,2*" IsVisible="False">
          <Border Classes="panel">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Content="Check for updates" Click="OnCheckAddonUpdates" />
                <Button Content="Update all" Click="OnUpdateAllAddons" />
                <Button Content="Open AddOns folder" Click="OnOpenAddons" />
              </StackPanel>
              <ScrollViewer>
                <StackPanel>
                  <TextBlock Classes="title" Text="FROM THE SERVER" />
                  <StackPanel Name="CatalogList" Spacing="4" />
                  <TextBlock Classes="title" Text="INSTALLED" Margin="0,16,0,10" />
                  <StackPanel Name="InstalledList" Spacing="4" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Classes="panel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Name="PreviewTitle" Classes="title" Text="PREVIEW" />
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Name="PreviewInstall" Content="Install" IsVisible="False" Click="OnPreviewInstall" />
                <Button Name="PreviewOpen" Classes="link" Content="Open on GitHub" IsVisible="False" Click="OnPreviewOpen" />
              </StackPanel>
              <ScrollViewer>
                <SelectableTextBlock Name="PreviewText" TextWrapping="Wrap" Foreground="#D8D2C4"
                                     Text="Pick an addon from the server's list to see its page." />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>

        <!-- 3 mods -->
        <Border Name="ModsPage" Classes="panel" IsVisible="False">
          <ScrollViewer>
            <StackPanel>
              <TextBlock Classes="title" Text="OPTIONS" />
              <TextBlock Classes="dim" Text="Fixes and extras from the server, never gameplay. The fixes are on by default; turn off any you don't want. Changes are installed (or removed) at the next update." />
              <StackPanel Name="OptionsList" Margin="0,8,0,0" Spacing="10" />
              <TextBlock Classes="section" Text="UNTRACKED PATCHES" />
              <TextBlock Classes="dim" Text="Patches in Data that neither the client nor the server hand out. They can break the game; removing moves them to the launcher's backup folder." />
              <StackPanel Name="UntrackedList" Margin="0,6,0,0" Spacing="4" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- 4 settings -->
        <Border Name="SettingsPage" Classes="panel" IsVisible="False">
          <ScrollViewer>
            <StackPanel>
              <TextBlock Classes="title" Text="SETTINGS" />
              <StackPanel Name="AccountSection">
              <TextBlock Classes="section" Text="ACCOUNT (the login for the server's game files)" />
              <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                <TextBox Name="UsernameBox" Watermark="Username" />
                <TextBox Grid.Column="2" Name="PasswordBox" Watermark="Password" PasswordChar="•" />
                <CheckBox Grid.Row="1" Name="RememberBox" Content="Remember password (Windows Credential Manager)" />
                <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Content="Connect" Click="OnConnect" Margin="0,4,0,0" />
              </Grid>
              <TextBlock Classes="dim" Margin="0,4,0,0" Text="Your own login from the server's owner." />
              </StackPanel>

              <TextBlock Classes="section" Text="WORLD OF WARCRAFT 3.3.5a FOLDER" />
              <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                <TextBox Name="WowFolderBox" Watermark="C:\Games\World of Warcraft" />
                <Button Grid.Column="2" Content="Browse…" Click="OnBrowseWow" />
                <Button Grid.Column="4" Name="ClientButton" Content="Install game files…" Click="OnDownloadClient" />
              </Grid>
              <TextBlock Classes="dim" Margin="0,4,0,0" Text="No game yet? Press Install game files… and pick an empty folder: the whole client is downloaded there." />

              <TextBlock Classes="section" Text="LANGUAGES" />
              <TextBlock Classes="dim" Text="The game languages to install." />
              <WrapPanel Name="LocalePanel" Margin="0,4,0,0" />

              <TextBlock Classes="section" Text="GAME" />
              <CheckBox Name="AddonsBox" Content="Install the addons the server needs" IsChecked="True" />
              <CheckBox Name="ClearCacheBox" Content="Clean the client's Cache (WDB) on each launch" IsChecked="True" />

              <TextBlock Classes="section" Text="BACKUPS" />
              <TextBlock Classes="dim" Text="Your settings, macros, key bindings and addons (WTF and Interface\AddOns)." />
              <CheckBox Name="BackupBox" Content="Back up before every update" IsChecked="True" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button Content="Back up now" Click="OnBackupNow" />
                <ComboBox Name="BackupList" MinWidth="360" />
                <Button Content="Restore" Click="OnRestoreBackup" />
                <Button Content="Open folder" Click="OnOpenBackups" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button Content="Export macros and key bindings…" Click="OnExportMacros" />
                <Button Content="Import macros and key bindings…" Click="OnImportMacros" />
              </StackPanel>

              <TextBlock Classes="section" Text="GAME FILES" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Verify game files" Click="OnVerify" />
                <Button Name="UpdateButton" Content="Check for updates" Click="OnUpdate" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- 5 launcher -->
        <Border Name="LauncherPage" Classes="panel" IsVisible="False">
          <ScrollViewer>
            <StackPanel>
              <TextBlock Classes="title" Text="LAUNCHER" />
              <CheckBox Name="ReopenBox" Content="Reopen the launcher after WoW closes" IsChecked="True" />
              <CheckBox Name="RememberWindowBox" Content="Remember position and size of the launcher window" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <TextBlock VerticalAlignment="Center" Text="Launcher background:" />
                <Button Content="Choose picture…" Click="OnPickBackground" />
                <Button Content="Default" Click="OnDefaultBackground" />
              </StackPanel>
              <TextBlock Name="LauncherVersionText" Classes="dim" Margin="0,10,0,0" />

              <TextBlock Classes="section" Text="LOG" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open log file" Click="OnOpenLog" />
              </StackPanel>
              <TextBox Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="220" Margin="0,8,0,0"
                       FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Panel>
    </DockPanel>

    <!-- login: asked first, like a website's login prompt -->
    <Grid Name="LoginOverlay" Background="#F20E0B14" IsVisible="False">
      <Border Classes="panel" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Image Source="/Assets/temucraft.png" Width="56" Height="56" />
            <TextBlock Text="TEMUCRAFT" FontSize="30" FontWeight="Black" Foreground="#F2C14E" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="dim" HorizontalAlignment="Center" TextAlignment="Center"
                     Text="Log in to get the game files. Your login comes from the server's owner." />
          <TextBox Name="LoginUser" Watermark="Username" />
          <TextBox Name="LoginPass" Watermark="Password" PasswordChar="•" />
          <CheckBox Name="LoginRemember" Content="Remember me (Windows Credential Manager)" />
          <TextBlock Name="LoginError" Foreground="#FF7A6A" TextWrapping="Wrap" IsVisible="False" />
          <Grid ColumnDefinitions="*,8,Auto">
            <Button Name="LoginButton" Content="Log in" IsDefault="True" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Click="OnLogin" />
            <Button Grid.Column="2" Content="Not now" Click="OnLoginLater" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
</Window>
